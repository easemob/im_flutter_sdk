{
  "data": {
    "unique": {
      "messageContent": "edit-before-",
      "editedContent": "edit-after-",
      "editMarker": "edit-marker-"
    }
  },
  "steps": [
    {
      "id": "init",
      "api": "ChatClient.init",
      "params": {
        "config": "$global.biz.config.initConfig",
        "overrides": {}
      }
    },
    {
      "id": "login_alice",
      "api": "ChatClient.loginWithToken",
      "params": {
        "userId": "$global.account.account1.userId",
        "token": "$global.account.account1.userToken"
      }
    },
    {
      "id": "login_bob",
      "api": "ChatClient.loginWithToken",
      "params": {
        "userId": "$global.account.account2.userId",
        "token": "$global.account.account2.userToken"
      }
    },
    {
      "id": "connected",
      "api": "ChatClient.isConnected",
      "params": {},
      "expect": {
        "success": true,
        "checks": [
          {
            "path": "",
            "equals": true
          }
        ]
      }
    },
    {
      "id": "send",
      "api": "ChatManager.sendMessage",
      "params": {
        "to": "$global.account.account2.userId",
        "chatType": 0,
        "body": {
          "type": 0,
          "content": "$global.biz.input.messageContent"
        }
      },
      "expect": {
        "success": true,
        "checks": [
          {
            "path": "msgId",
            "notEmpty": true
          }
        ]
      }
    },
    {
      "id": "edit",
      "api": "ChatManager.modifyMessage",
      "params": {
        "messageId": "$global.biz.result.sent.data.msgId",
        "content": "$global.biz.input.editedContent",
        "attributes": {
          "testRun": "$global.biz.input.editMarker"
        }
      },
      "expect": {
        "success": true,
        "checks": [
          {
            "path": "msgId",
            "equals": "$global.biz.result.sent.data.msgId"
          },
          {
            "path": "body.content",
            "equals": "$global.biz.input.editedContent"
          },
          {
            "path": "attributes.testRun",
            "equals": "$global.biz.input.editMarker"
          }
        ]
      }
    },
    {
      "id": "logout",
      "api": "ChatClient.logout",
      "params": {
        "unbindDeviceToken": true
      }
    }
  ],
  "requiredBindings": [
    "global.biz.result.alice_init",
    "global.biz.result.bob_init",
    "global.biz.result.alice_login",
    "global.biz.result.bob_login",
    "global.biz.result.alice_connected",
    "global.biz.result.bob_connected",
    "global.biz.result.sent",
    "global.biz.event.received",
    "global.biz.result.edited",
    "global.biz.event.edited",
    "global.biz.result.alice_logout",
    "global.biz.result.bob_logout"
  ]
}
