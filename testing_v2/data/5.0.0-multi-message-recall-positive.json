{
  "data": {
    "unique": {
      "messageContent": "recall-message-",
      "recallMarker": "recall-marker-"
    }
  },
  "steps": [
    {
      "id": "init",
      "api": "ChatClient.init",
      "params": {
        "config": "$global.biz.config.initConfig",
        "overrides": {}
      }
    },
    {
      "id": "login_alice",
      "api": "ChatClient.loginWithToken",
      "params": {
        "userId": "$global.account.alice.userId",
        "token": "$global.account.alice.userToken"
      }
    },
    {
      "id": "login_bob",
      "api": "ChatClient.loginWithToken",
      "params": {
        "userId": "$global.account.bob.userId",
        "token": "$global.account.bob.userToken"
      }
    },
    {
      "id": "connected",
      "api": "ChatClient.isConnected",
      "params": {},
      "expect": {
        "success": true,
        "checks": [
          {
            "path": "",
            "equals": true
          }
        ]
      }
    },
    {
      "id": "send",
      "api": "ChatManager.sendMessage",
      "params": {
        "to": "$global.account.bob.userId",
        "chatType": 0,
        "body": {
          "type": 0,
          "content": "$global.biz.input.messageContent"
        }
      },
      "expect": {
        "success": true,
        "checks": [
          {
            "path": "msgId",
            "notEmpty": true
          }
        ]
      }
    },
    {
      "id": "recall",
      "api": "ChatManager.recallMessage",
      "params": {
        "messageId": "$global.biz.result.sent.data.msgId",
        "ext": "$global.biz.input.recallMarker"
      }
    },
    {
      "id": "logout",
      "api": "ChatClient.logout",
      "params": {
        "unbindDeviceToken": true
      }
    }
  ],
  "requiredBindings": [
    "global.biz.result.alice_init",
    "global.biz.result.bob_init",
    "global.biz.result.alice_login",
    "global.biz.result.bob_login",
    "global.biz.result.alice_connected",
    "global.biz.result.bob_connected",
    "global.biz.result.sent",
    "global.biz.event.received",
    "global.biz.result.recalled",
    "global.biz.event.recalled",
    "global.biz.result.alice_logout",
    "global.biz.result.bob_logout"
  ]
}
