# 共享环境配置模板（与 im-test-hub 的 app: schema 一致）
#
# 使用方式（在 native-auto-test 目录）：
#   cp config/env.yaml.template config/config.yaml
#   vim config/config.yaml          # 填入真实环境信息
#   bash skills/im-flutter-run/scripts/run.sh --config config/config.yaml
#
# 文件选择优先级：
#   环境文件：--config <path> > IM_TEST_CONFIG > native-auto-test/config/config.yaml
#   桥接文件：--bridge-config <path> > IM_BRIDGE_CONFIG > native-auto-test/config/bridge.yaml
# 不再读取根目录旧 config.yaml。
#
# 严禁提交真实凭据；以下尖括号内容均为待替换的占位符。
# config/*.yaml 已被 .gitignore 忽略，仅本模板与 bridge.yaml 入库。

app:
  # cluster：目标集群稳定标识（如 ebs、tke_qa、tke_sdb）。
  # im-test-hub 的环境条件用例仅使用该字段判断；本仓库仅透传。
  cluster: "ebs"

  # appkey：业务 appkey，固定格式 org#app。
  appkey: "<org>#<app>"

  # wait：业务稳定等待时间（秒），非负数字。本仓库当前不消费，仅保持 schema 一致。
  wait: 3

  # Python cases 等待（秒）：语义键 + 显式模块，不再读取旧时间环境变量。
  # 模块语义值 > 全局语义值 > 模块 default > 全局 default > 内置默认。
  # 完整语义词汇见 docs/case-timing-inventory.md；旧文件/函数长键会报错。
  # 按需取消注释单个字段，不必填全；step 标量等价于 step.interval。
  # case_timing:
  #   step: 1.0                       # 业务步骤之间，包括回调验证到下次操作
  #   settle:
  #     offline: 3.0                  # 退出后、重登前、重登后共用，不清回调
  #     normal: 5.0                   # 常规历史消息、群成员/配置稳定
  #     parent_message: 5.0           # 子区父消息可见性，独立于 normal
  #     slow: 15.0                    # 好友、reaction 同步
  #   timeout:
  #     event: 10.0                    # 全局普通回调
  #     group:
  #       group_event: 30.0            # 只覆盖 group 的群事件
  #       default: 60.0                # 该模块未显式指定语义值时的兜底
  #   observe:
  #     no_event: 3.0                  # 负向断言完整观察窗口
  #     collect: 10.0                  # 回调收集，保持原 helper 返回语义
  #   poll:
  #     interval: 1.0                  # 两次状态查询之间的 sleep
  #     receive: 2.0                   # 单次事件读取上限，不是 sleep
  #   drain:
  #     offline: 0.5                   # 共用的离线准备/恢复旧事件清理窗口
  #     generic: 2.0                   # session 通用清理
  #   retry:
  #     default: 1.0                   # 已有重试退避，不增加重试次数
  # step/settle/drain/retry 可设置 0；timeout/observe/poll 必须大于 0。
  # 模块覆盖支持 chat/group/chatroom/contact/client/presence/push/user_info/session/shared。
  # 模块标量（如 timeout: {group: 30}）等价于该模块 default；全局语义值仍优先。

  # console：可选，控制台信息。本仓库与 im-test-hub 当前均不消费，仅为兼容保留。
  console:
    url: ""
    username: ""
    password: ""

  # imm：IM Management / 环境治理配置。本仓库当前不消费，仅保持 schema 一致。
  imm:
    url: ""
    username: ""
    password: ""
    cluster: ""

  # server：Server REST 与凭据。
  server:
    # base_url：仅协议 + 主机，不包含 /org/app 路径。
    # 推荐 HTTPS；HTTP 会在传输过程中明文暴露凭据。
    base_url: "https://a1.easemob.com"

    # client_id / client_secret：用于 client_credentials 换取 REST token（推荐）。
    # 留空则 REST 不可用，测试会降级为通过 WS createAccount 预创建用户；
    # 部分环境禁止开放注册，此时必须配置 client 凭据。
    client_id: ""
    client_secret: ""

    # verify_ssl：是否校验证书。缺失默认 true；仅测试环境自签名证书时才设为 false。
    verify_ssl: true

  # sdk：SDK 行为验证相关配置。
  sdk:
    user_login_password: "1"

    # rest_host：SDK REST 覆盖地址；留空时回退 server.base_url。
    rest_host: ""

    # msync：SDK 长连接配置。
    # DNS 派生规则：tcp_host 或 websocket_host 非空 => enableDNSConfig=false；
    #               两者都空 => enableDNSConfig=true。rest_host 与 datasync 不影响该判定。
    msync:
      # protocol：tcp / websocket。
      protocol: "websocket"

      # tcp_host / tcp_port：MSYNC TCP 显式地址；走 DNS 时留空。
      tcp_host: ""
      tcp_port: ""

      # websocket_host / websocket_port：MSYNC WebSocket 显式地址；走 DNS 时留空。
      websocket_host: ""
      websocket_port: ""

      # enable_lz4：是否协商 transport 级 LZ4。0 / 1。
      enable_lz4: "0"

      # compress_algorimth：外层 MSync 压缩算法。
      # 可选：COMPRESS_NONE / COMPRESS_ZLIB / COMPRESS_LZ4（字段名沿用 proto 历史拼写 algorimth）。
      compress_algorimth: "COMPRESS_ZLIB"

      # sync_delay：收到 NOTICE 后延迟首次队列拉取，单位毫秒。本仓库当前不消费。
      sync_delay: 0

  # datasync：Gateway DataSync 第二通道兜底地址。留空表示不自定义。
  datasync:
    websocket_host: ""
    websocket_port: ""
    websocket_path: "/ws"
    use_ssl: "1"

  # log：SDK / Server 文件日志配置。
  log:
    enable_file_log: "1"
    log_dir: "log"

# 测试 App 固定设置（不放进本文件，硬编码在 im_flutter_test 初始化代码）：
# autoLogin / debugMode / requireAck / requireDeliveryAck / enableUserInfo = true，
# enableAutoSyncContacts = false。这些设置不改变发布 SDK 的默认值。
