# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
**/build/

# Test/runtime caches and generated reports
**/.dart_tool/
**/.pytest_cache/
**/__pycache__/
**/.venv/
**/allure-results/
**/allure-report/
**/out/
**/report.html

# Web/build outputs
**/node_modules/
**/dist/
*.apk
*.aab
*.ipa
*.xcarchive/

# Local test configuration (use the checked-in templates instead)
/native-auto-test/config.yaml
/im_flutter_test/assets/config.yaml

# Do not commit lock files
**/*.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/
.fvmrc
/scripts/shengwang_chat_sdk
/scripts/agora_chat_sdk
/scripts/im_flutter_sdk

# Local SDK assets (do not commit)
# Android local deps (folder name without version; jars/so live under it)
im_flutter_sdk_android/android/libs/easemob-sdk/
# Allow keeping the directory placeholder but ignore contents
im_flutter_sdk_android/android/libs/easemob-sdk/**
# Also ignore accidental versioned folders
im_flutter_sdk_android/android/libs/easemob-sdk-*/

# iOS vendored frameworks (local deps)
im_flutter_sdk_ios/ios/HyphenateChat.xcframework/
im_flutter_sdk_ios/ios/ShengwangInfra_iOS/

# Pods are typically not committed from example app
im_flutter_sdk/example/ios/Pods/
