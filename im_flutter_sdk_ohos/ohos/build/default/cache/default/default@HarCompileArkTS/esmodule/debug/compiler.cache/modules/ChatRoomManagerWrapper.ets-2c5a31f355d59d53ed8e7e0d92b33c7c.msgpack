                data.set("roomId", roomId);
                data.set("participant", participant);
                if (ext != null) {
                    data.set("ext", ext);
                }
                retrievedObject?.channel?.invokeMethod(MethodKey.chatRoomChange, data);
            },
            //
            onMemberExited(roomId, roomName, participant) {
