        }
    }
    loadMsgWithTime(call, result) {
        let conversation = this.conversationWithParam(call);
        if (conversation) {
            let startTime = call.argument('startTime');
            let endTime = call.argument('endTime');
            let maxCount = call.argument('count');
            conversation.searchMessagesBetweenTime(startTime, endTime, maxCount).then(r => {
                let messageResult = [];
                r.forEach(message => {
                    let map = MessageHelper.toJson(message);
