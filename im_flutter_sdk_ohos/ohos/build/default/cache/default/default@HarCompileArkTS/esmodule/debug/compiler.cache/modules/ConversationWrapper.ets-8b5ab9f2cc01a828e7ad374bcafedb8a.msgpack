        if (conversation) {
            this.onSuccess(result, call.method, conversation.getAllMsgCount());
        }
        else {
            this.onError(result, ChatError.createError(ChatError.INVALID_PARAM, 'Conversation is undefined!'));
        }
    }
    removeMsgFromServerWithMsgList(call, result) {
        let convId = call.argument("convId");
        let type = call.argument('type');
        let msgIds = call.argument('msgIds');
        ChatClient.getInstance().chatManager()?.removeMessagesFromServer(convId, type, msgIds)?.then(() => {
            this.onSuccess(result, call.method);
        }).catch((e) => {
            this.onError(result, e);
        });
    }
    removeMsgFromServerWithTimeStamp(call, result) {
        let convId = call.argument("convId");
        let type = call.argument('type');
        let timestamp = call.argument('timestamp');
        ChatClient.getInstance().chatManager()?.removeMessagesFromServer(convId, type, timestamp)?.then(() => {
            this.onSuccess(result, call.method);
        }).catch((e) => {
            this.onError(result, e);
        });
    }
    pinnedMessages(call, result) {
        let conversation = this.conversationWithParam(call);
        if (conversation) {
            conversation.getPinnedMessages().then(r => {
                let messageResult = [];
                r.forEach(message => {
                    let map = MessageHelper.toJson(message);
                    if (map) {
                        messageResult.push(map);
                    }
                });
                this.onSuccess(result, call.method, messageResult);
            }).catch((e) => {
                this.onError(result, e);
            });
        }
        else {
            this.onError(result, ChatError.createError(ChatError.INVALID_PARAM, 'Conversation is undefined!'));
        }
    }
    remindType(call, result) {
        let conversation = this.conversationWithParam(call);
        if (conversation) {
            this.onSuccess(result, call.method, conversation.pushRemindType());
        }
        else {
            this.onError(result, ChatError.createError(ChatError.INVALID_PARAM, 'Conversation is undefined!'));
        }
    }
    // todo æ ¡éªŒæ¶ˆæ¯ç±»å‹æ˜¯å¦æ­£ç¡®
    searchMsgByOptions(call, result) {
        let conversation = this.conversationWithParam(call);
        if (conversation) {
            let timestamp = call.argument('ts');
            let maxCount = call.argument('count');
            let from = '';
            if (call.hasArgument('from')) {
                from = call.argument('from');
            }
            let direction = SearchDirection.UP;
            if (call.hasArgument('direction')) {
                direction = call.argument('direction');
            }
            let msgTypes = call.argument('types');
            conversation.searchMessagesByType(msgTypes, timestamp, maxCount, from, direction).then(r => {
                let messageResult = [];
                r.forEach(message => {
                    let map = MessageHelper.toJson(message);
                    if (map) {
                        messageResult.push(map);
                    }
                });
                this.onSuccess(result, call.method, messageResult);
            }).catch((e) => {
                this.onError(result, e);
            });
        }
        else {
            this.onError(result, ChatError.createError(ChatError.INVALID_PARAM, 'Conversation is undefined!'));
        }
    }
    getLocalMessageCount(call, result) {
        let conversation = this.conversationWithParam(call);
        if (conversation) {
            let startMs = call.argument('startMs');
            let endMs = call.argument('endMs');
            this.onSuccess(result, call.method, conversation.getMsgCountInRange(startMs, endMs));
        }
        else {
            this.onError(result, ChatError.createError(ChatError.INVALID_PARAM, 'Conversation is undefined!'));
        }
    }
    deleteLocalAndServerMessages(call, result) {
        let convId = call.argument("convId");
        let type = call.argument('type');
        let msgIds = call.argument('msgIds');
        ChatClient.getInstance().chatManager()?.removeMessagesFromServer(convId, type, msgIds).then(() => {
            this.onSuccess(result, call.method);
        }).catch((e) => {
            this.onError(result, e);
        });
    }
    deleteLocalAndServerMessagesByTime(call, result) {
        let convId = call.argument("convId");
        let type = call.argument('type');
        let beforeMs = call.argument('beforeMs');
        ChatClient.getInstance().chatManager()?.removeMessagesFromServer(convId, type, beforeMs).then(() => {
            this.onSuccess(result, call.method);
        }).catch((e) => {
            this.onError(result, e);
        });
    }
    conversationWithParam(call) {
        let convId = call.argument("convId");
        let type = call.argument('type');
        return ChatClient.getInstance().chatManager()?.getConversation(convId, type, true);
    }
}
