    loadMsgWithMsgType(call, result) {
        let conversation = this.conversationWithParam(call);
        if (conversation) {
            let timestamp = call.argument('timestamp');
            let maxCount = call.argument('count');
            let from = '';
            if (call.hasArgument('sender')) {
                from = call.argument('sender');
            }
            let direction = SearchDirection.UP;
            if (call.hasArgument('direction')) {
                direction = call.argument('direction');
            }
            let msgType = call.argument('msgType');
            conversation.searchMessagesByType(msgType, timestamp, maxCount, from, direction).then(r => {
                let messageResult = [];
