{
  "data": {
    "unique": {"firstContent": "multibody-first-", "secondContent": "multibody-second-"}
  },
  "steps": [
    {
      "id": "init_alice",
      "api": "ChatClient.init",
      "params": {"config": "$global.biz.config.initConfig", "overrides": {}}
    },
    {
      "id": "init_bob",
      "api": "ChatClient.init",
      "params": {"config": "$global.biz.config.initConfig", "overrides": {}}
    },
    {
      "id": "login_alice",
      "api": "ChatClient.loginWithToken",
      "params": {
        "userId": "$global.account.account1.userId",
        "token": "$global.account.account1.userToken"
      }
    },
    {
      "id": "login_bob",
      "api": "ChatClient.loginWithToken",
      "params": {
        "userId": "$global.account.account2.userId",
        "token": "$global.account.account2.userToken"
      }
    },
    {
      "id": "connected",
      "api": "ChatClient.isConnected",
      "params": {},
      "expect": {"success": true, "checks": [{"path": "", "equals": true}]}
    },
    {
      "id": "send",
      "api": "ChatManager.sendMessage",
      "params": {
        "to": "$global.account.account2.userId",
        "chatType": 0,
        "bodies": [
          {"type": 0, "content": "$global.biz.input.firstContent"},
          {"type": 0, "content": "$global.biz.input.secondContent"}
        ]
      },
      "expect": {
        "success": true,
        "checks": [
          {"path": "msgId", "notEmpty": true},
          {"path": "bodies", "length": 2}
        ]
      }
    },
    {
      "id": "logout",
      "api": "ChatClient.logout",
      "params": {"unbindDeviceToken": true}
    }
  ],
  "requiredBindings": [
    "global.biz.result.alice_init",
    "global.biz.result.bob_init",
    "global.biz.result.alice_login",
    "global.biz.result.bob_login",
    "global.biz.result.alice_connected",
    "global.biz.result.bob_connected",
    "global.biz.result.sent",
    "global.biz.event.received"
  ]
}
