{
  "_comment": "1.16.0-ohos negative path (auto mode). init/login are engine-managed and must not be scripted. Every api name here exists in im_flutter_sdk/example/lib/registry. Each step must fail with an SDK ChatError carrying a positive code: translateMessage on a msgId that is not in the local DB is rejected by the ohos wrapper with the literal 500 before any service call; the group, presence and cursor steps fail on the server or chatsdk validation side, whose concrete codes depend on the deployment, so those steps assert success:false only. autoLoadConversations=false matches the documented precondition of fetchConversationsFromDB, which then rejects an undecodable cursor.",
  "init": {
    "autoLoadConversations": false
  },
  "steps": [
    {
      "api": "ChatManager.translateMessage",
      "id": "translate_missing_message",
      "params": {
        "message": {
          "msgId": "ohos-nonexistent-msg-id",
          "to": "$config.accounts.0.id",
          "chatType": 0,
          "direction": 0,
          "status": 2,
          "body": {
            "type": 0,
            "content": "must not be translated"
          }
        },
        "languages": [
          "zh-Hans"
        ]
      },
      "expect": {
        "errorCode": 500
      }
    },
    {
      "api": "ChatGroupManager.updateGroupNamecard",
      "id": "namecard_empty_group",
      "params": {
        "groupId": "",
        "namecard": "must not be applied"
      },
      "expect": {
        "success": false
      }
    },
    {
      "api": "ChatGroupManager.updateGroupNamecard",
      "id": "namecard_unknown_group",
      "params": {
        "groupId": "ohos-nonexistent-group",
        "namecard": "must not be applied"
      },
      "expect": {
        "success": false
      }
    },
    {
      "api": "ChatPresenceManager.publishPresence",
      "id": "presence_desc_too_long",
      "params": {
        "desc": ""
      },
      "expect": {
        "success": false
      }
    },
    {
      "api": "ChatPresenceManager.fetchSubscribedMembers",
      "id": "presence_page_size_zero",
      "params": {
        "pageNum": 1,
        "pageSize": 0
      },
      "expect": {
        "success": false
      }
    },
    {
      "api": "ChatManager.fetchConversationsFromDB",
      "id": "conversations_invalid_cursor",
      "params": {
        "cursor": "ohos-invalid-cursor",
        "pageSize": 20
      },
      "expect": {
        "success": false
      }
    }
  ]
}
