{
  "_comment": "1.16.0-ohos positive path (auto mode). init/login are engine-managed and must not be scripted. Every api name here exists in im_flutter_sdk/example/lib/registry. $config.accounts.0 is the account the engine logs in with (first lib/env.dart account); $config.accounts.1 is the peer account; $config.groups.0 must be a group the first account belongs to, otherwise the two namecard steps fail (both come from lib/env.dart generated by `make env-gettoken`). autoLoadConversations=false is the documented precondition of ChatManager.fetchConversationsFromDB. The translation step needs the message-translation service enabled; without it the step reports 305 SERVICE_NOT_ENABLE, an environment limitation (same class as 4.x modifyMessage).",
  "init": {
    "autoLoadConversations": false
  },
  "steps": [
    {
      "api": "ChatUserInfoManager.fetchUserInfoById",
      "id": "user_info_self",
      "params": {
        "userIds": [
          "$config.accounts.0.id"
        ],
        "expireTime": 0
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatUserInfoManager.updateUserInfo",
      "id": "user_info_update_self",
      "params": {
        "sign": "ohos-1.16.0 positive"
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatUserInfoManager.getLocalUserInfoByIds",
      "id": "user_info_local_self",
      "params": {
        "userIds": [
          "$config.accounts.0.id"
        ]
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatUserInfoManager.subscribeUsersInfo",
      "id": "user_info_subscribe_peer",
      "params": {
        "userIds": [
          "$config.accounts.1.id"
        ]
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatUserInfoManager.fetchSubscribedUsers",
      "id": "user_info_subscribed",
      "params": {},
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatUserInfoManager.unsubscribeUsersInfo",
      "id": "user_info_unsubscribe_peer",
      "params": {
        "userIds": [
          "$config.accounts.1.id"
        ]
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatPresenceManager.publishPresence",
      "id": "presence_publish",
      "params": {
        "desc": "ohos-1.16.0 positive presence"
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatPresenceManager.subscribe",
      "id": "presence_subscribe_peer",
      "params": {
        "members": [
          "$config.accounts.1.id"
        ],
        "expiry": 86400
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatPresenceManager.fetchSubscribedMembers",
      "id": "presence_members",
      "params": {
        "pageNum": 1,
        "pageSize": 20
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatPresenceManager.fetchPresenceStatus",
      "id": "presence_status_peer",
      "params": {
        "members": [
          "$config.accounts.1.id"
        ]
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatPresenceManager.unsubscribe",
      "id": "presence_unsubscribe_peer",
      "params": {
        "members": [
          "$config.accounts.1.id"
        ]
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatManager.sendMessage",
      "id": "msg_self",
      "params": {
        "to": "$config.accounts.0.id",
        "chatType": 0,
        "direction": 0,
        "status": 0,
        "body": {
          "type": 0,
          "content": "ohos-1.16.0 positive self-chat"
        }
      },
      "delayAfterMs": 1000,
      "expect": {
        "success": true,
        "checks": [
          {
            "path": "msgId",
            "notEmpty": true
          }
        ]
      }
    },
    {
      "api": "ChatManager.translateMessage",
      "id": "message_translate_self",
      "params": {
        "message": "$step.msg_self",
        "languages": [
          "zh-Hans"
        ]
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatManager.fetchConversationsFromDB",
      "id": "conversations",
      "params": {
        "cursor": "",
        "pageSize": 20
      },
      "expect": {
        "success": true,
        "checks": [
          {
            "path": "list",
            "notEmpty": true
          }
        ]
      }
    },
    {
      "api": "ChatGroupManager.updateGroupNamecard",
      "id": "group_namecard_set",
      "params": {
        "groupId": "$config.groups.0.id",
        "namecard": "ohos-1.16.0 positive"
      },
      "expect": {
        "success": true
      }
    },
    {
      "api": "ChatGroupManager.getGroupNamecard",
      "id": "group_namecard_get",
      "params": {
        "groupId": "$config.groups.0.id",
        "userId": "$config.accounts.0.id"
      },
      "expect": {
        "success": true
      }
    }
  ]
}
