#!/usr/bin/env bash
# 报告汇总入口（example-testing-spec §3.5）。
# 用法: collect_report [--run-id <id>] [--list]
#   --run-id  指定运行；缺省取 testing/reports 下最新一个
#   --list    仅列出全部运行
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/_compat.sh" || exit 64
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
REPORTS="$ROOT/testing/reports"

LIST=0
RUN_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --run-id) RUN_ID="${2:?}"; shift 2 ;;
    --list) LIST=1; shift ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "collect_report: unknown arg: $1" >&2; exit 64 ;;
  esac
done

[[ -d "$REPORTS" ]] || { echo "collect_report: no reports yet ($REPORTS)"; exit 0; }
if [[ $LIST -eq 1 ]]; then
  ls -1t "$REPORTS"
  exit 0
fi
if [[ -z "$RUN_ID" ]]; then
  RUN_ID="$(ls -1t "$REPORTS" | head -1)"
  [[ -n "$RUN_ID" ]] || { echo "collect_report: no reports yet"; exit 0; }
  echo "latest run: $RUN_ID"
fi

python3 - "$REPORTS/$RUN_ID" <<'PY'
import json, sys, os
run_dir = sys.argv[1]
flow = os.path.join(run_dir, 'flow-report.json')
if os.path.exists(flow):
    d = json.load(open(flow))
    print('flow:', d.get('flowName'), '| runId:', d.get('runId'))
    for s in d.get('steps', []):
        mark = {'passed': 'PASS', 'failed': 'FAIL', 'timeout': 'TIME', 'skipped': 'SKIP'}.get(s.get('status'), '?')
        print(f"  [{mark}] {s.get('kind')} {s.get('name')} @ {s.get('agent')} ({s.get('durationMs')}ms) ctx={s.get('context')}")
        if s.get('status') != 'passed' and s.get('reason'):
            print(f"         reason: {s['reason']}")
    print('summary:', json.dumps(d.get('summary', {})))
else:
    print('flow-report.json not found; files:')
    for f in sorted(os.listdir(run_dir)):
        print('  ', f)
PY
