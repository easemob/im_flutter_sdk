#!/usr/bin/env bash
# Agent 冒烟编排（agent-service §10 冒烟序列的自动化版本）。
# 用法: smoke_agent [--platform ios|android] [--device <id>] [--run-id <id>] [--keep-app]
# 组合: prepare_data → setup_devices(control) → 自动 curl 断言序列 → 终止 app
# 断言内容: info/握手、init 特例、login、普通命令信封、事件流、expect 兼容、
#           未知字段容忍、422/401/404/405、finish 后 410。
# 退出码: 0 = 全部通过；1 = 存在失败（附实际响应）。
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/_compat.sh" || exit 64
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
BUNDLE_ID="com.example.example"
PLATFORM="ios"
DEVICE=""
RUN_ID="smoke-$(date +%Y%m%d-%H%M%S)"
KEEP_APP=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --platform) PLATFORM="${2:?}"; shift 2 ;;
    --device) DEVICE="${2:?}"; shift 2 ;;
    --run-id) RUN_ID="${2:?}"; shift 2 ;;
    --keep-app) KEEP_APP=1; shift ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "smoke_agent: unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ "$PLATFORM" == ios || "$PLATFORM" == android ]] || { echo "smoke_agent: --platform ios|android" >&2; exit 64; }

PASS=0; FAIL=0
check() { # check <描述> <期望子串> <实际>
  if grep -qF "$2" <<< "$3"; then
    echo "PASS  $1"; PASS=$((PASS + 1))
  else
    echo "FAIL  $1"; echo "      expect-contains: $2"; echo "      actual: $3"; FAIL=$((FAIL + 1))
  fi
}
cget()  { curl --noproxy '*' -s -H "$AUTH" "$B$1"; }
cpost() { curl --noproxy '*' -s -X POST -H "$AUTH" -H 'Content-Type: application/json' -d "${2:-{\}}" "$B$1"; }
poll() { # poll <commandId> → 终态 JSON
  for i in $(seq 1 60); do
    r="$(cget "/v1/commands/$1")"
    grep -qE '"status":"(done|timeout)"' <<< "$r" && { echo "$r"; return 0; }
    sleep 0.5
  done
  echo "POLL-TIMEOUT $r"
}

# 1) 数据 + 设备（复用编排脚本）
"$HERE/prepare_data" --run-id "$RUN_ID"
SETUP_ARGS=(--platform "$PLATFORM" --mode control --run-id "$RUN_ID")
[[ -n "$DEVICE" ]] && SETUP_ARGS+=(--devices "$DEVICE")
"$HERE/setup_devices" "${SETUP_ARGS[@]}"

AGENTS="$ROOT/testing/tmp/$RUN_ID/agents.json"
ENV="$ROOT/testing/tmp/$RUN_ID/main/environment.json"
read -r ENDPOINT TOKEN < <(python3 -c "
import json
a = json.load(open('$AGENTS'))[0]
print(a['endpoint'], a['token'])")
B="$ENDPOINT"; AUTH="Authorization: Bearer $TOKEN"
UDID="$(python3 -c "import json; print(json.load(open('$AGENTS'))[0]['udid'])")"

# 2) 断言序列（agent-service §10）
r="$(cget /v1/info)";                                         check "info: accepting" '"state":"accepting"' "$r"
check "info: version 2" '"version":2' "$r"

python3 - "$ENV" > /tmp/smoke-c-init.json <<'PY'
import json, sys
env = json.load(open(sys.argv[1]))
print(json.dumps({'commandId': 'c-init', 'api': 'ChatClient.init',
                  'timeoutMs': 15000, 'params': {'config': env, 'overrides': {}}}))
PY
r="$(curl --noproxy '*' -s -X POST -H "$AUTH" -H 'Content-Type: application/json' -d @/tmp/smoke-c-init.json "$B/v1/commands")"
check "init: accepted" '"status":"accepted"' "$r"
r="$(poll c-init)";                                            check "init: done" '"status":"done"' "$r"

python3 - "$ENV" > /tmp/smoke-c-login.json <<'PY'
import json, sys
a = json.load(open(sys.argv[1]))['accounts'][0]
print(json.dumps({'commandId': 'c-login', 'api': 'ChatClient.loginWithToken',
                  'timeoutMs': 15000, 'params': {'userId': a['id'], 'token': a['token']}}))
PY
r="$(curl --noproxy '*' -s -X POST -H "$AUTH" -H 'Content-Type: application/json' -d @/tmp/smoke-c-login.json "$B/v1/commands")"
check "login: accepted" '"status":"accepted"' "$r"
r="$(poll c-login)";                                           check "login: done" '"status":"done"' "$r"

r="$(cpost /v1/commands '{"commandId":"c-1","api":"ChatClient.isConnected","params":{},"timeoutMs":10000}')"
check "cmd: accepted" '"status":"accepted"' "$r"
r="$(poll c-1)";                                               check "cmd: done+data" '"data":true' "$r"
check "cmd: evidence range" '"evidence"' "$r"

r="$(cget "/v1/events?afterSeq=0&limit=200")"
check "events: agent.command" 'agent.command' "$r"
check "events: api.*" 'api.ChatClient' "$r"

r="$(cpost /v1/commands '{"commandId":"c-2","api":"ChatManager.getUnreadMessageCount","params":{},"expect":{"success":true}}')"
r="$(poll c-2)";                                               check "expect compat: matched" '"expectMatched":true' "$r"

r="$(cpost /v1/commands '{"commandId":"c-3","api":"ChatClient.isConnected","params":{},"id":"legacy","foo":1}')"
check "unknown fields tolerated" '"status":"accepted"' "$r"

r="$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' -X POST -H "$AUTH" -H 'Content-Type: application/json' -d '{"commandId":"c-x","api":"NotAReal.api","params":{}}' "$B/v1/commands")"
check "unregistered api: 422" '422' "$r"
r="$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' "$B/v1/info")"
check "no auth: 401" '401' "$r"
r="$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' -H "$AUTH" "$B/v1/nope")"
check "unknown route: 404" '404' "$r"
r="$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' -X PUT -H "$AUTH" "$B/v1/commands")"
check "wrong method: 405" '405' "$r"

r="$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' -X POST -H "$AUTH" -H 'Content-Type: application/json' -d '{}' "$B/v1/finish")"
check "finish: 200" '200' "$r"
r="$(cget /v1/info)";                                          check "closed state" '"state":"closed"' "$r"
r="$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' -X POST -H "$AUTH" -H 'Content-Type: application/json' -d '{"commandId":"c-9","api":"ChatClient.isConnected","params":{}}' "$B/v1/commands")"
check "command after finish: 410" '410' "$r"

# 3) 收尾
if [[ $KEEP_APP -ne 1 ]]; then
  if [[ "$PLATFORM" == ios ]]; then
    xcrun simctl terminate "$UDID" "$BUNDLE_ID" 2>/dev/null || true
  else
    adb -s "$UDID" shell am force-stop "$BUNDLE_ID" 2>/dev/null || true
    # 回收 adb forward 的宿主端口
    HP="$(python3 -c "import json; print(json.load(open('$AGENTS'))[0]['endpoint'].rsplit(':',1)[1])" 2>/dev/null || true)"
    [[ -n "$HP" ]] && adb -s "$UDID" forward --remove "tcp:$HP" 2>/dev/null || true
  fi
  [[ -f "$ROOT/testing/tmp/$RUN_ID/agent-1.log.pid" ]] && kill "$(cat "$ROOT/testing/tmp/$RUN_ID/agent-1.log.pid")" 2>/dev/null || true
fi

echo "----------------------------------------"
echo "SMOKE RESULT: PASS=$PASS FAIL=$FAIL  (run-id: $RUN_ID)"
[[ $FAIL -eq 0 ]] || exit 1
