#!/usr/bin/env bash
# 单设备执行入口（example-testing-spec §3.3 直跑路径）。
# 用法: run_single --platform <ios|android> --script <name.json> [--device <id>]
# 转发现有 make auto-report（flutter run + API_SCRIPT + 报告），不改其行为。
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/_compat.sh" || exit 64
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

PLATFORM=""
SCRIPT=""
DEVICE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --platform) PLATFORM="${2:?}"; shift 2 ;;
    --script) SCRIPT="${2:?}"; shift 2 ;;
    --device) DEVICE="${2:?}"; shift 2 ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "run_single: unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ "$PLATFORM" == ios || "$PLATFORM" == android ]] || { echo "run_single: --platform <ios|android> required" >&2; exit 64; }
[[ -n "$SCRIPT" ]] || { echo "run_single: --script required" >&2; exit 64; }

cd "$ROOT"
exec make auto-report PLATFORM="$PLATFORM" SCRIPT="$SCRIPT" ${DEVICE:+DEVICE="$DEVICE"}
