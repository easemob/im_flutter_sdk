#!/usr/bin/env bash
# 数据准备入口（example-testing-spec §3.1）。
# 用法: prepare_data [--run-id <id>] [--flow <yaml> | --roles <csv>] [--data <json>] [--groups 0|1]
#   --run-id   运行标识，缺省按时间戳生成；决定 testing/tmp/<run-id>/ 的隔离环境
#   --groups   额外创建的临时群数量（供群场景引用），缺省 0
# --data explicitly overrides the declaration in the flow's command JSON.
# Outputs: data-declaration.json + main/environment.json + role-data.json + data.json.
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/_compat.sh" || exit 64
set -euo pipefail
umask 077
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

RUN_ID="$(date +%Y%m%d-%H%M%S)"
# 注意：不能用 GROUPS 做变量名——bash 特殊变量（用户组 ID 数组），赋值无效，
# 会导致循环次数变成主组 ID。
N_GROUPS=0
FLOW=""
ROLES=""
DATA=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --run-id) RUN_ID="${2:?}"; shift 2 ;;
    --groups) N_GROUPS="${2:?}"; shift 2 ;;
    --flow) FLOW="${2:?}"; shift 2 ;;
    --roles) ROLES="${2:?}"; shift 2 ;;
    --data) DATA="${2:?}"; shift 2 ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "prepare_data: unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ "$RUN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$ ]] || { echo "prepare_data: invalid run-id" >&2; exit 64; }
[[ "$N_GROUPS" == 0 || "$N_GROUPS" == 1 ]] || { echo "prepare_data: current resource tool supports 0 or 1 group per run" >&2; exit 64; }
# Resolve caller paths before changing the working directory.
if [[ -n "$FLOW" ]]; then
  [[ -z "$ROLES" ]] || { echo "prepare_data: use --flow or --roles, not both" >&2; exit 64; }
  [[ -f "$FLOW" ]] || FLOW="$ROOT/testing/flows/$FLOW"
  FLOW="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$FLOW")"
  ROLES="$(cd "$ROOT" && dart run testing/tools/runner/context.dart roles "$FLOW")"
fi
ROLES="${ROLES:-agent-1}"
if [[ -n "$DATA" ]]; then
  [[ -f "$DATA" ]] || { echo "prepare_data: data declaration not found" >&2; exit 66; }
  DATA="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$DATA")"
fi

# A repeat must fail before refreshing tokens or creating server resources.
[[ ! -f "$ROOT/testing/tmp/$RUN_ID/data-declaration.json" && ! -f "$ROOT/testing/tmp/$RUN_ID/main/environment.json" && ! -f "$ROOT/testing/tmp/$RUN_ID/role-data.json" ]] || { echo 'prepare_data: data already exists; use a fresh run ID' >&2; exit 65; }
cd "$ROOT"
# Resolve and snapshot declarations before refreshing tokens or creating resources.
DECLARATION="$ROOT/testing/tmp/$RUN_ID/data-declaration.json"
DECLARATION_ARGS=("$DECLARATION")
[[ -z "$FLOW" ]] || DECLARATION_ARGS+=(--flow "$FLOW")
[[ -z "$DATA" ]] || DECLARATION_ARGS+=(--data "$DATA")
dart run testing/tools/data/declaration.dart "${DECLARATION_ARGS[@]}"
if [[ ! -f testing/config/environment.local.json ]]; then
  echo "==> make config（首次导入本地配置）"
  make config
fi
echo "==> make env-gettoken RUN_ID=$RUN_ID"
make env-gettoken RUN_ID="$RUN_ID"
for ((i = 1; i <= N_GROUPS; i++)); do
  echo "==> prepare-group #$i"
  dart run testing/tools/data/resources.dart prepare-group "$RUN_ID"
done

dart run testing/tools/data/roles.dart "$RUN_ID" "$ROLES" "$DECLARATION"
if [[ -n "$FLOW" ]]; then
  dart run testing/tools/data/preconditions.dart "$FLOW" --run-id "$RUN_ID"
fi

echo "OK RUN_ID=$RUN_ID"
echo "OK environment=testing/tmp/$RUN_ID/main/environment.json"
