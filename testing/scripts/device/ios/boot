#!/usr/bin/env bash
# iOS 模拟器启动 + 就绪等待（原子脚本）。
# 用法: device/ios/boot --device <udid> [--timeout <sec>]
# 已启动的直接成功；shutdown 的执行 boot 并用 bootstatus -b 等待就绪。
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/../../_compat.sh" || exit 64
set -euo pipefail
DEVICE=""
TIMEOUT=180
while [[ $# -gt 0 ]]; do
  case "$1" in
    --device) DEVICE="${2:?}"; shift 2 ;;
    --timeout) TIMEOUT="${2:?}"; shift 2 ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "ios/boot: unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ -n "$DEVICE" ]] || { echo "ios/boot: --device required" >&2; exit 64; }

# 注意：simctl 输出行尾带空格，不能用 $ 锚定；无匹配时 grep 返回 1，
# 在 pipefail 下会静默中止，故显式兜底给出错误信息。
STATE="$(xcrun simctl list devices | grep "($DEVICE)" | grep -oE '\((Shutdown|Booted)\)' | tail -1 | tr -d '() ' || true)"
[[ -n "$STATE" ]] || { echo "ios/boot: cannot determine device state: $DEVICE" >&2; exit 66; }
if [[ "$STATE" == "Booted" ]]; then
  echo "OK booted already: $DEVICE"
  exit 0
fi
echo "==> simctl boot $DEVICE"
xcrun simctl boot "$DEVICE"
echo "==> bootstatus (timeout ${TIMEOUT}s)"
xcrun simctl bootstatus "$DEVICE" -b -t "$TIMEOUT"
echo "OK booted: $DEVICE"
