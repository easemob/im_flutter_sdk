#!/usr/bin/env bash
# iOS 模拟器枚举/选择（原子脚本，供上层编排调用）。
# 用法: device/ios/list [--booted|--available] [--json]
#   --booted     仅已启动的
#   --available  仅可用的（默认）
#   --json       输出 [{udid, name, state}]，供机器解析
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/../../_compat.sh" || exit 64
set -euo pipefail
FILTER="available"
JSON=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --booted) FILTER="booted" ;;
    --available) FILTER="available" ;;
    --json) JSON=1 ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "ios/list: unknown arg: $1" >&2; exit 64 ;;
  esac
  shift
done

xcrun simctl list devices "$FILTER" | python3 -c "
import sys, json, re
out = []
for line in sys.stdin:
    m = re.match(r'\s*(.+?) \((.+?)\) \((\w+)\)\s*$', line)
    if m:
        out.append({'name': m.group(1), 'udid': m.group(2), 'state': m.group(3)})
if $JSON:
    print(json.dumps(out))
else:
    for d in out:
        print(f\"{d['udid']}  {d['state']:<9} {d['name']}\")
"
