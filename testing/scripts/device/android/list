#!/usr/bin/env bash
# Android 设备枚举（原子脚本）。
# 用法: device/android/list [--json]
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/../../_compat.sh" || exit 64
set -euo pipefail
JSON=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1 ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "android/list: unknown arg: $1" >&2; exit 64 ;;
  esac
  shift
done
adb devices -l | python3 -c "
import sys, json
out = []
for line in sys.stdin.readlines()[1:]:
    parts = line.split()
    if len(parts) >= 2 and parts[1] == 'device':
        model = next((p.split(':', 1)[1] for p in parts[2:] if p.startswith('model:')), '')
        out.append({'udid': parts[0], 'model': model})
print(json.dumps(out) if $JSON else '\n'.join(f\"{d['udid']}  {d['model']}\" for d in out) or '')
"
