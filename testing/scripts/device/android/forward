#!/usr/bin/env bash
# Android 端口转发（原子脚本）。iOS 模拟器宿主可直连，无需转发。
# 用法: device/android/forward --device <udid> --port <local> [--remove]
#   --remove  移除该端口转发
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/../../_compat.sh" || exit 64
set -euo pipefail
DEVICE=""
PORT=""
REMOVE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --device) DEVICE="${2:?}"; shift 2 ;;
    --port) PORT="${2:?}"; shift 2 ;;
    --remove) REMOVE=1; shift ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "android/forward: unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ -n "$DEVICE" && -n "$PORT" ]] || { echo "android/forward: --device/--port required" >&2; exit 64; }

if [[ $REMOVE -eq 1 ]]; then
  adb -s "$DEVICE" forward --remove "tcp:$PORT"
  echo "OK removed tcp:$PORT"
else
  adb -s "$DEVICE" forward "tcp:$PORT" "tcp:$PORT"
  echo "OK forwarded tcp:$PORT on $DEVICE"
fi
