#!/usr/bin/env bash
# 多设备执行入口（example-testing-spec §3.4）。
# 用法: run_flow --flow <name.yaml> [--extra "<flow_runner args>"] [--no-verify]
#   --flow          流程 YAML（testing/flows/ 下的文件名或绝对路径）
#   --extra         透传给 flow_runner 的附加参数（如 --run-id、--report-dir）
#   --no-verify     跳过 cmd id 静态校验（草稿期）
# 前置: setup_devices --mode control 已完成（agents.json 就绪）。
# 产物: testing/reports/<run-id>/flow-report.json
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/_compat.sh" || exit 64
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

FLOW=""
EXTRA=""
NOVERIFY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --flow) FLOW="${2:?}"; shift 2 ;;
    --extra) EXTRA="${2:?}"; shift 2 ;;
    --no-verify) NOVERIFY=1; shift ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "run_flow: unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ -n "$FLOW" ]] || { echo "run_flow: --flow required" >&2; exit 64; }

FLOW_PATH="$FLOW"
[[ -f "$FLOW_PATH" ]] || FLOW_PATH="$ROOT/testing/flows/$FLOW"

ARGS=(run "$FLOW_PATH" --report-dir testing/reports)
[[ $NOVERIFY -eq 1 ]] && ARGS+=(--no-verify-commands)
[[ -n "$EXTRA" ]] && read -r -a EXTRA_ARGS <<< "$EXTRA" && ARGS+=("${EXTRA_ARGS[@]}")

cd "$ROOT"
echo "==> flow_runner ${ARGS[*]}"
exec dart run tool/flow_runner/bin/flow_runner.dart "${ARGS[@]}"
