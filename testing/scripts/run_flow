#!/usr/bin/env bash
# Multi-device composition: prepare data -> prepare devices -> bind -> execute.
# Usage: run_flow --flow <yaml> --platform ios|android|mixed [--devices id1,id2]
#        [--run-id <id>] [--prebuilt platform=path] [--data <json>]
#        [--prepared] [--keep-app]
# --prepared uses this run's existing data.json and devices.json; execution cannot be resumed/repeated.
# Runtime data and evidence: testing/tmp/<run-id>/; report: testing/reports/<run-id>/.
. "$(dirname "$0")/_compat.sh" || exit 64
set -euo pipefail
umask 077
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
FLOW=""; PLATFORM=""; DEVICES=""; PREBUILT=""; DATA=""
RUN_ID="flow-$(date +%Y%m%d-%H%M%S)"
PREPARED=0; KEEP_APP=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --flow) FLOW="${2:?}"; shift 2 ;;
    --run-id) RUN_ID="${2:?}"; shift 2 ;;
    --platform) PLATFORM="${2:?}"; shift 2 ;;
    --devices) DEVICES="${2:?}"; shift 2 ;;
    --prebuilt) PREBUILT="${2:?}"; shift 2 ;;
    --data) DATA="${2:?}"; shift 2 ;;
    --prepared) PREPARED=1; shift ;;
    --keep-app) KEEP_APP=1; shift ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "run_flow: unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ -n "$FLOW" ]] || { echo 'run_flow: --flow required' >&2; exit 64; }
[[ "$RUN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$ ]] || { echo 'run_flow: invalid run-id' >&2; exit 64; }
[[ -f "$FLOW" ]] || FLOW="$ROOT/testing/flows/$FLOW"
FLOW="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$FLOW")"
[[ -f "$FLOW" ]] || { echo 'run_flow: flow not found' >&2; exit 66; }
[[ -z "$DATA" ]] || DATA="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$DATA")"
cd "$ROOT"
ROLES="$(dart run testing/tools/runner/context.dart roles "$FLOW")"
COUNT="$(python3 -c 'import sys; print(len(sys.argv[1].split(",")))' "$ROLES")"
RUN_DIR="$ROOT/testing/tmp/$RUN_ID"
if [[ $PREPARED -eq 0 ]]; then
  [[ "$PLATFORM" == ios || "$PLATFORM" == android || "$PLATFORM" == mixed ]] || { echo 'run_flow: --platform required unless --prepared' >&2; exit 64; }
  [[ ! -e "$RUN_DIR" ]] || { echo 'run_flow: run directory exists; use a fresh ID or --prepared' >&2; exit 65; }
else
  [[ -f "$RUN_DIR/data.json" && -f "$RUN_DIR/devices.json" && ! -f "$RUN_DIR/flow.yaml" ]] || { echo 'run_flow: prepared data/devices missing or context already used' >&2; exit 65; }
fi
mkdir -p "$RUN_DIR"
# Keep the original failure code. Cleanup/evidence has a separate outcome.
finish_run() {
  code=$?
  trap - EXIT
  if [[ $KEEP_APP -eq 0 && -f "$RUN_DIR/devices.json" ]]; then
    python3 testing/tools/runner/stop_devices.py "$RUN_DIR" || echo 'WARN: device cleanup incomplete; inspect cleanup.json' >&2
  fi
  python3 - "$RUN_DIR" "$code" <<'RESULT'
import json,sys
from pathlib import Path
p=Path(sys.argv[1]); (p/'exit.json').write_text(json.dumps({'exitCode':int(sys.argv[2])})+'\n')
report=p.parents[1]/'reports'/p.name
report.mkdir(parents=True,exist_ok=True)
summary={'runId':p.name,'exitCode':int(sys.argv[2]),'runtimeDir':str(p),'files':sorted(f.name for f in p.iterdir() if f.is_file())}
if (p/'cleanup.json').exists(): summary['cleanup']=json.loads((p/'cleanup.json').read_text())
(report/'runtime-index.json').write_text(json.dumps(summary,indent=2)+'\n')
RESULT
  exit "$code"
}
trap finish_run EXIT
if [[ $PREPARED -eq 0 ]]; then
  DATA_ARGS=(--run-id "$RUN_ID" --flow "$FLOW")
  [[ -z "$DATA" ]] || DATA_ARGS+=(--data "$DATA")
  "$HERE/prepare_data" "${DATA_ARGS[@]}"
  DEVICE_ARGS=(--run-id "$RUN_ID" --platform "$PLATFORM" --count "$COUNT" --roles "$ROLES" --mode control)
  [[ -z "$DEVICES" ]] || DEVICE_ARGS+=(--devices "$DEVICES")
  [[ -z "$PREBUILT" ]] || DEVICE_ARGS+=(--prebuilt "$PREBUILT")
  "$HERE/setup_devices" "${DEVICE_ARGS[@]}"
fi
dart run testing/tools/runner/context.dart bind "$RUN_ID" "$FLOW"
dart run tool/flow_runner/bin/flow_runner.dart run "$RUN_DIR/flow.yaml" \
  --agents-file "$RUN_DIR/agents.json" --globals-file "$RUN_DIR/global.json" \
  --evidence-dir "$RUN_DIR" --report-dir "$ROOT/testing/reports" \
  > "$RUN_DIR/run.log" 2>&1 || { code=$?; cat "$RUN_DIR/run.log"; exit "$code"; }
cat "$RUN_DIR/run.log"
"$HERE/collect_report" --run-id "$RUN_ID"
