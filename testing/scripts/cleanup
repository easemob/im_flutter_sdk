#!/usr/bin/env bash
# 清理入口（example-testing-spec §3.6）：三类清理各自独立，失败不覆盖测试结果。
# 用法: cleanup --run-id <id> [--keep-tmp]
#   --run-id    必填：本次运行标识
#   --keep-tmp  保留 testing/tmp/<run-id>/（默认会检查 reports 归档后删除）
# Shell: bash >= 3.2（macOS 系统自带即满足；勿用 sh/zsh 直接执行，见 _compat.sh）
. "$(dirname "$0")/_compat.sh" || exit 64
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

RUN_ID=""
KEEP_TMP=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --run-id) RUN_ID="${2:?}"; shift 2 ;;
    --keep-tmp) KEEP_TMP=1; shift ;;
    -h|--help) grep '^# ' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "cleanup: unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ -n "$RUN_ID" ]] || { echo "cleanup: --run-id required" >&2; exit 64; }

cd "$ROOT"

# 1) 服务端资源：只清理本次创建且归属明确的资源
echo "==> cleanup-group $RUN_ID"
dart run testing/tools/data/resources.dart cleanup-group "$RUN_ID" || echo "WARN: cleanup-group failed（不覆盖测试结果，继续）" >&2

# 2) 临时目录：证据已归档到 reports 才可删除
if [[ $KEEP_TMP -eq 0 && -d "testing/tmp/$RUN_ID" ]]; then
  if compgen -G "testing/reports/*" > /dev/null; then
    echo "==> remove testing/tmp/$RUN_ID（报告已在 testing/reports/ 归档）"
    rm -rf "testing/tmp/$RUN_ID"
  else
    echo "WARN: testing/reports 为空，保留 testing/tmp/$RUN_ID（证据未归档）" >&2
  fi
fi

# 3) 本地进程：agent 模式的 app 进程（--console-pty 后台进程）
echo "==> 提示：如仍有 agent app 在运行，可 xcrun simctl terminate <udid> com.example.example"
echo "OK cleanup run-id=$RUN_ID"
